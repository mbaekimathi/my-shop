# Minimal .env — most settings auto-detect local vs hosted.
# Never commit .env — only .env.example belongs in git.
#
# LOCAL (XAMPP): use the MySQL defaults below.
# PRODUCTION (cPanel): uncomment APP_ENV=production and set the four MYSQL_* lines.

# ---------------------------------------------------------------------------
# PRODUCTION (cPanel / Passenger) — copy to .env on the server (not in git)
# ---------------------------------------------------------------------------
# APP_ENV=production
# MYSQL_ENABLED=True
# MYSQL_DATABASE=yourcpaneluser_dbname
# MYSQL_USER=yourcpaneluser_dbuser
# MYSQL_PASSWORD=your_cpanel_mysql_password
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_READ_TIMEOUT=600
# MYSQL_WRITE_TIMEOUT=600
# MYSQL_CONNECT_TIMEOUT=30
# MYSQL_CONN_MAX_AGE=0
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=your-domain.com,www.your-domain.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.com,https://www.your-domain.com
# DARAJA_CALLBACK_BASE_URL=https://your-domain.com
# PUBLIC_SITE_URL=https://your-domain.com
# Nexus collections STK (Production only). Use trailing slash.
# NEXUS_STK_URL=https://fin.richcom.co.ke/api/v1/collections/stk/
# NEXUS_STK_AUTH=x-api-key
# Only if migrate/check times out:
# MYSQL_UNIX_SOCKET=/var/lib/mysql/mysql.sock

# ---------------------------------------------------------------------------
# LOCAL (XAMPP) defaults — copy this file to .env for development
# ---------------------------------------------------------------------------
MYSQL_ENABLED=True
MYSQL_DATABASE=myshop
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# Optional overrides (omit for auto):
# DJANGO_DEBUG=auto
# DJANGO_SECRET_KEY=   # auto-creates .secret_key if empty
# DJANGO_ALLOWED_HOSTS=auto
# DJANGO_CSRF_TRUSTED_ORIGINS=auto
# SESSION_COOKIE_AGE=1209600
# CSRF_COOKIE_AGE=315360000
# DARAJA_CALLBACK_BASE_URL=
# SERVE_MEDIA_IN_PRODUCTION=auto
# REDIS_URL=
# COMMS_SEND_MODE=auto
# COMMS_INLINE_SEND=0
# COMMS_CRON_BATCH_SIZE=15
# WHATSAPP_MEDIA_MAX_BYTES=4194304
# GOOGLE_MAPS_API_KEY=
