DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Trust Host / HTTPS headers from ngrok or a reverse proxy
DJANGO_USE_X_FORWARDED_HOST=True

# Comma-separated HTTPS origins for CSRF (required in production)
# Example: https://shop.example.com,https://www.shop.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# Optional STK callback override (leave empty — auto-detects from the URL you open)
# Example when using ngrok: DARAJA_CALLBACK_BASE_URL=https://xxxx.ngrok-free.app
DARAJA_CALLBACK_BASE_URL=

# MySQL via PyMySQL (defaults match local XAMPP/WAMP: root, empty password)
MYSQL_ENABLED=True
MYSQL_DATABASE=myshop
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_CONN_MAX_AGE=300

# Redis — enables distributed cache, faster sessions, and Celery workers
# Leave empty to use in-process LocMem cache (single-server / cPanel OK)
REDIS_URL=

# Celery (uses REDIS_URL broker when set)
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# Pagination
EMPLOYEE_LIST_PAGE_SIZE=25

# Rate limits (requests per window seconds, per client IP)
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW=60
RATE_LIMIT_CHECK_ID_MAX=30
RATE_LIMIT_CHECK_ID_WINDOW=60
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_REGISTER_WINDOW=300

# ---------------------------------------------------------------------------
# Production (cPanel / VPS) — copy these when going live
# ---------------------------------------------------------------------------
# DJANGO_DEBUG=False
# DJANGO_SECRET_KEY=<generate a long random string>
# DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SERVE_MEDIA_IN_PRODUCTION=True
# DARAJA_CALLBACK_BASE_URL=https://yourdomain.com
# MYSQL_HOST=localhost
# MYSQL_USER=<cpanel_db_user>
# MYSQL_PASSWORD=<cpanel_db_password>
# MYSQL_DATABASE=<cpanel_db_name>
# MYSQL_CONN_MAX_AGE=60

# Production media — set True on cPanel when using local disk uploads
SERVE_MEDIA_IN_PRODUCTION=False

# Gunicorn (VPS overrides)
# GUNICORN_BIND=127.0.0.1:8000
# GUNICORN_WORKERS=3
# GUNICORN_THREADS=2
# GUNICORN_TIMEOUT=120
