# Minimal .env — most settings auto-detect local vs hosted.
# Override only what you need.

# Optional: local | production | auto (default)
# APP_ENV=auto

# MySQL (change these on cPanel/VPS to your hosting DB)
MYSQL_ENABLED=True
MYSQL_DATABASE=myshop
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# Optional overrides (leave blank / omit for auto):
# DJANGO_DEBUG=auto
# DJANGO_SECRET_KEY=   # auto-creates .secret_key file if empty
# DJANGO_ALLOWED_HOSTS=auto
# DJANGO_CSRF_TRUSTED_ORIGINS=auto
# DARAJA_CALLBACK_BASE_URL=   # auto from public HTTPS / ngrok
# SERVE_MEDIA_IN_PRODUCTION=auto
# REDIS_URL=
