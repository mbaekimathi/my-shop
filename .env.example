# Minimal .env — most settings auto-detect local vs hosted.
# Never commit .env — only .env.example belongs in git.
#
# LOCAL (XAMPP): use the MySQL defaults below.
# PRODUCTION (cPanel): copy the PRODUCTION block into server .env (never commit it).

# ---------------------------------------------------------------------------
# PRODUCTION — pos.richcom.co.ke (cPanel / Passenger)
# Copy block below to .env on the server (never commit .env).
# ---------------------------------------------------------------------------
# APP_ENV=production
#
# MYSQL_ENABLED=True
# MYSQL_DATABASE=richcomc_my_shop
# MYSQL_USER=richcomc_my_shop
# MYSQL_PASSWORD=your_cpanel_mysql_password
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_READ_TIMEOUT=600
# MYSQL_WRITE_TIMEOUT=600
# MYSQL_CONNECT_TIMEOUT=30
# MYSQL_CONN_MAX_AGE=0
# If "Can't connect to MySQL ... localhost (111 Connection refused)", uncomment
# and set the socket path from cPanel → MySQL (common: /var/lib/mysql/mysql.sock
# or /tmp/mysql.sock):
# MYSQL_UNIX_SOCKET=/var/lib/mysql/mysql.sock
#
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=pos.richcom.co.ke,www.pos.richcom.co.ke
# DJANGO_CSRF_TRUSTED_ORIGINS=https://pos.richcom.co.ke,https://www.pos.richcom.co.ke
#
# PUBLIC_SITE_URL=https://pos.richcom.co.ke
# DARAJA_CALLBACK_BASE_URL=https://pos.richcom.co.ke
#
# GOOGLE_MAPS_API_KEY=
#
# WhatsApp campaigns: cron worker (avoids LiteSpeed LSAPI_CHILDREN exhaustion)
# COMMS_SEND_MODE=cron
# COMMS_INLINE_SEND=0
# COMMS_CRON_BATCH_SIZE=15
#
# Optional — Redis/Celery:
# REDIS_URL=
#
# Hosted STK credentials (server .env only — not used on local dev):
# DARAJA_ENVIRONMENT=production
# DARAJA_STK_PROVIDER=daraja
# DARAJA_CONSUMER_KEY=
# DARAJA_CONSUMER_SECRET=
# DARAJA_PASSKEY=
# DARAJA_SHORTCODE=
# DARAJA_ENABLE_STK_PUSH=1
# DARAJA_CREDENTIALS_VALID=1
# NEXUS_STK_URL=https://fin.richcom.co.ke/api/v1/collections/stk/
# NEXUS_API_KEY=
# NEXUS_COLLECTION_ID=
# NEXUS_KEY_VERIFIED=1
#
# Hosted Twilio / WhatsApp (server .env only when APP_ENV=production):
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# TWILIO_FROM_NUMBER=
# TWILIO_WHATSAPP_JOIN_CODE=control-did
#
# Hosted SMS:
# SMS_PROVIDER=africas_talking
# SMS_API_KEY=
# SMS_API_SECRET=
# SMS_SENDER_ID=
# SMS_API_BASE_URL=
#
# Message channel + optional SMTP:
# MESSAGE_FROM_NAME=
# MESSAGE_REPLY_TO=
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=1
# DEFAULT_FROM_EMAIL=
#
# DJANGO_SECRET_KEY=   # optional; auto-creates .secret_key if empty

# ---------------------------------------------------------------------------
# LOCAL (XAMPP) defaults — copy this file to .env for development
# ---------------------------------------------------------------------------
MYSQL_ENABLED=True
MYSQL_DATABASE=myshop
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# Optional overrides (omit for auto):
# DJANGO_DEBUG=auto
# DJANGO_SECRET_KEY=   # auto-creates .secret_key if empty
# DJANGO_ALLOWED_HOSTS=auto
# DJANGO_CSRF_TRUSTED_ORIGINS=auto
# SESSION_COOKIE_AGE=1209600
# CSRF_COOKIE_AGE=315360000
# DARAJA_CALLBACK_BASE_URL=
# SERVE_MEDIA_IN_PRODUCTION=auto
# REDIS_URL=
# COMMS_SEND_MODE=auto
# COMMS_INLINE_SEND=0
# COMMS_CRON_BATCH_SIZE=15
# On LiteSpeed/cPanel: keep COMMS_INLINE_SEND=0 and use cron (process_comms_queue).
# Increase LSAPI_CHILDREN in hosting if you see "max children process limit" warnings.
# WHATSAPP_MEDIA_MAX_BYTES=4194304
# GOOGLE_MAPS_API_KEY=
