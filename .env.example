# Minimal .env — most settings auto-detect local vs hosted.
# Override only what you need.
#
# LOCAL (XAMPP): use the defaults below (root, empty password, 127.0.0.1).
# CPANEL PRODUCTION (/home3/.../POS/.env): copy the block in README or use:
#   MYSQL_DATABASE=yourcpanel_yourdb
#   MYSQL_USER=yourcpanel_youruser
#   MYSQL_PASSWORD=your_cpanel_mysql_password
#   MYSQL_HOST=localhost
# Never commit .env — it stays only on each machine/server.

# Optional: local | production | auto (default)
# APP_ENV=production

# MySQL — local defaults (change all four lines on cPanel)
MYSQL_ENABLED=True
MYSQL_DATABASE=myshop
MYSQL_USER=root
MYSQL_PASSWORD=
# Local XAMPP: 127.0.0.1 — cPanel/VPS production: localhost
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
# cPanel only if the website times out but "manage.py check" passes:
# MYSQL_UNIX_SOCKET=/var/lib/mysql/mysql.sock

# Optional overrides (leave blank / omit for auto):
# DJANGO_DEBUG=auto
# DJANGO_SECRET_KEY=   # auto-creates .secret_key file if empty
# DJANGO_ALLOWED_HOSTS=auto
# DJANGO_CSRF_TRUSTED_ORIGINS=auto
# Employee session lifetime in seconds (default 14 days). Shop portal
# stays signed in until Sign out, independent of this value.
# SESSION_COOKIE_AGE=1209600
# CSRF_COOKIE_AGE=315360000
# DARAJA_CALLBACK_BASE_URL=   # auto from public HTTPS / ngrok
# SERVE_MEDIA_IN_PRODUCTION=auto
# REDIS_URL=
# COMMS_SEND_MODE=auto
# COMMS_INLINE_SEND=0
# COMMS_CRON_BATCH_SIZE=15
# cPanel cron (every minute): python manage.py process_comms_queue
# WHATSAPP_MEDIA_MAX_BYTES=4194304
# Google Maps Places API key (storefront delivery location autocomplete)
# GOOGLE_MAPS_API_KEY=
